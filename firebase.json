{
  "functions": [{
    "source": "functions",
    "codebase": "admin-announcements",
    "ignore": ["node_modules", ".git", "*.log", "test"]
  }],
  "hosting": {
    "public": "build/public-site",
    "ignore": ["firebase.json", "**/.*", "**/*.apk"],
    "headers": [
      {"source": "/update.json", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
      {"source": "/downloads/**", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "Content-Type", "value": "application/vnd.android.package-archive"}]}
    ]
  }
}
