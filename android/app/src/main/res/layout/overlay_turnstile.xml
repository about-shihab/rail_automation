<?xml version="1.0" encoding="utf-8"?>
<!--
  Bangladesh Railway Boarding Pass • Turnstile Verification Overlay
  Designed as a genuine Railway Ticket with animated Passenger Boarding Scene.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9060D1A">

    <!-- Centered Boarding Pass Ticket Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/overlay_card_bg"
        android:elevation="16dp"
        android:orientation="vertical">

        <!-- ── 1. Ticket Header (Bangladesh Railway Emerald Gradient) ──────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_ticket_header_bg"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Train Badge Icon -->
                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/overlay_ticket_pill"
                    android:gravity="center"
                    android:text="🚆"
                    android:textSize="20sp" />

                <!-- Header Title & Subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="BANGLADESH RAILWAY • E-TICKET"
                        android:textColor="#A7F3D0"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Processing Ticket • Boarding"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Close button -->
                <TextView
                    android:id="@+id/btnClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/overlay_ticket_pill"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Train Context Pill -->
            <TextView
                android:id="@+id/tvContextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/overlay_ticket_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="TURNA (741) • SELECT SEAT TYPE"
                android:textColor="#FDE68A"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ── 2. Ticket Body Content ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- ── 3. Animated Passenger Boarding Scene ─────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/overlay_train_platform_bg"
                android:padding="8dp">

                <!-- Station Platform Horizon & Tracks Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp"
                    android:background="#334155" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="12dp"
                    android:background="#1E293B" />

                <!-- Station Banner Top Tag -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.05"
                    android:text="STATION PLATFORM 1 • BOARDING GATE"
                    android:textColor="#64748B"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <!-- Bangladesh Railway Carriage (Right Side) -->
                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="#065F46"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <!-- Carriage Door -->
                    <View
                        android:layout_width="16dp"
                        android:layout_height="36dp"
                        android:background="#047857" />

                    <!-- Windows with Light -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="match_parent"
                            android:background="#FEF08A" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="match_parent"
                            android:background="#FEF08A" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="match_parent" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="match_parent"
                            android:background="#FEF08A" />

                    </LinearLayout>

                    <!-- Red Carriage Stripe -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#DC2626" />

                </LinearLayout>

                <!-- Animated Walking Passenger (Moves from left into carriage door) -->
                <TextView
                    android:id="@+id/ivPassenger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="14dp"
                    android:layout_marginStart="24dp"
                    android:text="🚶‍♂️🧳"
                    android:textSize="18sp" />

                <!-- Status Caption -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="1dp"
                    android:text="⚡ Holding coach seats... Entering train"
                    android:textColor="#34D399"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- ── 4. Perforated Ticket Divider ─────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#334155" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:letterSpacing="0.06"
                    android:text="HUMAN VERIFICATION REQUIRED"
                    android:textColor="#94A3B8"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#334155" />

            </LinearLayout>

            <!-- ── 5. Instruction Prompt ────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tap the verification checkbox below to confirm seat reservation"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <!-- ── 6. Cloudflare Turnstile Challenge Box ────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/overlay_webview_box"
                android:padding="2dp">

                <WebView
                    android:id="@+id/webViewTurnstile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent" />

            </FrameLayout>

            <!-- ── 7. Cancel Button ─────────────────────────────────────────── -->
            <TextView
                android:id="@+id/btnCancelText"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="Cancel &amp; Continue in App"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
